<Project>
  <!--
    학습자 코드를 컴파일할 때 쓰는 참조 어셈블리(타입 정보만 있는 파일).
    전체(약 160개, 2MB)가 아니라 코스에서 쓰는 것만 SDK의 참조 팩에서 골라 엔진에 포함한다.
    여기 없는 라이브러리를 쓰면 "형식이나 네임스페이스를 찾을 수 없습니다" 컴파일 오류가 난다.
    목록을 바꾸면 CsEngine.csproj의 TrimmerRootAssembly(실행용 구현)도 같이 맞출 것.
  -->
  <PropertyGroup>
    <LabRefDir>$(NetCoreTargetingPackRoot)/Microsoft.NETCore.App.Ref/$(BundledNETCoreAppPackageVersion)/ref/net10.0/</LabRefDir>
  </PropertyGroup>
  <ItemGroup>
    <LabRefName Include="System.Runtime" />
    <LabRefName Include="System.Collections" />
    <LabRefName Include="System.Collections.Concurrent" />
    <LabRefName Include="System.Console" />
    <LabRefName Include="System.Linq" />
    <LabRefName Include="System.Memory" />
    <LabRefName Include="System.ObjectModel" />
    <LabRefName Include="System.Runtime.Numerics" />
    <LabRefName Include="System.Text.RegularExpressions" />
    <LabRefName Include="System.Threading" />
    <LabRefName Include="System.Threading.Tasks" />
    <LabRefName Include="System.Runtime.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="@(LabRefName->'$(LabRefDir)%(Identity).dll')">
      <LogicalName>labref.%(Filename).dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="LabCheckRefs" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(LabRefDir)System.Runtime.dll')" Text="참조 팩을 찾을 수 없습니다: $(LabRefDir)" />
    <Message Importance="high" Text="LabRefs: $(LabRefDir)" />
  </Target>
</Project>
