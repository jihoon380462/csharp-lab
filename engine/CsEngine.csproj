<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CsEngine</AssemblyName>

    <!-- 학습자 코드가 어떤 표준 라이브러리 API를 부를지 모르므로 트리밍하지 않는다.
         (트리밍하면 컴파일은 되는데 실행 중 MissingMethodException이 날 수 있음) -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- 한국어 문화권(ko) 사용: 한국어 오류 메시지 리소스를 쓰려면 Invariant 모드를 끄고
         ICU는 필요한 조각(CJK)만 받는다 -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>

    <!-- Roslyn 한국어 에러 메시지만 포함 -->
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>

    <!-- 압축본(.br/.gz)은 로더에서 직접 사용 -->
    <CompressionEnabled>true</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.*" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Basic.Reference.Assemblies.Net80" Version="1.*" />
  </ItemGroup>

</Project>
